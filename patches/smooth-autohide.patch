+static gboolean
+panel_window_autohide_ease_in (gpointer data)
+{
+  PanelWindow *window = PANEL_WINDOW (data);
+
+  gint x, y;
+  gint target_x, target_y;
+  gint hidden_x, hidden_y;
+  gdouble progress;
+  gdouble eased;
+
+  if (window->autohide_ease_in_reverse)
+    {
+      window->autohide_ease_in_progress -= 0.08;
+
+      if (window->autohide_ease_in_progress <= 0.0)
+        {
+          window->autohide_ease_in_progress = 0.0;
+
+          hidden_x = window->alloc.x;
+          hidden_y = window->alloc.y;
+
+          if (IS_HORIZONTAL (window))
+            {
+              if (window->snap_position == SNAP_POSITION_N
+                  || window->snap_position == SNAP_POSITION_NC
+                  || window->snap_position == SNAP_POSITION_NW
+                  || window->snap_position == SNAP_POSITION_NE)
+                hidden_y -= window->alloc.height;
+              else
+                hidden_y += window->alloc.height;
+            }
+          else
+            {
+              if (window->snap_position == SNAP_POSITION_W
+                  || window->snap_position == SNAP_POSITION_WC
+                  || window->snap_position == SNAP_POSITION_NW
+                  || window->snap_position == SNAP_POSITION_SW)
+                hidden_x -= window->alloc.width;
+              else
+                hidden_x += window->alloc.width;
+            }
+
+          gtk_window_move (GTK_WINDOW (window), hidden_x, hidden_y);
+
+          window->autohide_state = AUTOHIDE_HIDDEN;
+
+          /* Reposiciona a janela de captura do autohide na borda. */
+          gtk_widget_queue_resize (GTK_WIDGET (window));
+          window->autohide_ease_in_id = 0;
+          window->autohide_ease_in_reverse = FALSE;
+
+          g_print ("[PANEL] EASE-IN REVERSO: terminou oculto em %d,%d\n",
+                   hidden_x, hidden_y);
+
+          return FALSE;
+        }
+    }
+  else
+    {
+      window->autohide_ease_in_progress += 0.08;
+
+      if (window->autohide_ease_in_progress >= 1.0)
+        {
+          window->autohide_ease_in_progress = 1.0;
+
+          gtk_window_move (GTK_WINDOW (window),
+                           window->alloc.x,
+                           window->alloc.y);
+
+          window->autohide_ease_in_id = 0;
+          window->autohide_ease_in_reverse = FALSE;
+
+          g_print ("[PANEL] EASE-IN: terminou visível\n");
+
+          return FALSE;
+        }
+    }
+
+  progress = window->autohide_ease_in_progress;
+
+  eased = 1.0 - ((1.0 - progress)
+                 * (1.0 - progress)
+                 * (1.0 - progress));
+
+  target_x = window->alloc.x;
+  target_y = window->alloc.y;
+
+  if (IS_HORIZONTAL (window))
+    {
+      if (window->snap_position == SNAP_POSITION_N
+          || window->snap_position == SNAP_POSITION_NC
+          || window->snap_position == SNAP_POSITION_NW
+          || window->snap_position == SNAP_POSITION_NE)
+        {
+          y = target_y - window->alloc.height
+              + (gint) (window->alloc.height * eased);
+        }
+      else
+        {
+          y = target_y + window->alloc.height
+              - (gint) (window->alloc.height * eased);
+        }
+
+      x = target_x;
+    }
+  else
+    {
+      if (window->snap_position == SNAP_POSITION_W
+          || window->snap_position == SNAP_POSITION_WC
+          || window->snap_position == SNAP_POSITION_NW
+          || window->snap_position == SNAP_POSITION_SW)
+        {
+          x = target_x - window->alloc.width
+              + (gint) (window->alloc.width * eased);
+        }
+      else
+        {
+          x = target_x + window->alloc.width
+              - (gint) (window->alloc.width * eased);
+        }
+
+      y = target_y;
+    }
+
+  g_print ("[PANEL] EASE-IN %s: progresso=%.2f move=%d,%d\n",
+           window->autohide_ease_in_reverse ? "REVERSO" : "normal",
+           progress,
+           x, y);
+
+  gtk_window_move (GTK_WINDOW (window), x, y);
+
+  return TRUE;
+}
 
 
